# 填写自己的 OpenAI 兼容模型服务地址、模型名称和访问密钥。
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=your-model-name
MODEL_API_KEY=not-required
# 按模型服务的实际配置填写上下文长度；0 表示使用估算值检查输入。
MODEL_CONTEXT_TOKENS=0
MODEL_TOKENIZER_URL=
# 替换为随机密钥，同一部署的五个进程使用相同的值。
A2A_SECRET=replace-with-a-long-random-secret
HOST_URL=http://127.0.0.1:18210
PLANNER_URL=http://127.0.0.1:18211
WORKER_URL=http://127.0.0.1:18212
CRITIC_URL=http://127.0.0.1:18213
SYNTHESIZER_URL=http://127.0.0.1:18214
# 跨会话长期记忆与文档向量检索开关。
MEMORY_ENABLED=false
RAG_ENABLED=false
# 记忆嵌入服务；模型名称、向量维度及输入长度应与服务配置一致。
MEMORY_EMBEDDING_URL=
MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_MAX_TOKENS=1024
# 文档嵌入服务，可与记忆嵌入服务分别配置。
DOCUMENT_EMBEDDING_URL=
DOCUMENT_EMBEDDING_MODEL=BAAI/bge-m3
DOCUMENT_EMBEDDING_DIMENSIONS=1024
# 可选的检索结果重排服务。
RERANK_URL=
RERANK_API_KEY=
# 网页搜索服务与代理，按实际网络环境填写。
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_PROXY=
